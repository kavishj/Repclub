      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><button aria-current=\"page\">Your squad</button><button>Workouts</button><button>League</button></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:4px;flex-wrap:wrap;padding-bottom:12px}.ds-nav button{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:8px 18px;border:0;border-radius:var(--control-radius,999px);background:transparent;color:var(--muted,#aab8ca);font:400 14px/1.5 system-ui,sans-serif;white-space:nowrap;cursor:pointer;transition:background-color .16s,color .16s}.ds-nav button:hover{background:transparent;color:var(--text,#e5e9ee)}.ds-nav button[aria-current=page]{background:transparent;color:var(--accent-text,#b9f25b);font-weight:600}.ds-nav button:focus-visible{outline:2px solid var(--accent-text,#b9f25b);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-nav button{transition:none}}"

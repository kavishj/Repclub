  "narrative": {
    "northStar": "Clubhouse",
    "overview": "Clubhouse is the user-selected direction for RepClub, recorded on 3 November 2026 after comparing Training log, Clubhouse and Focus. OpenDesigner supplied the starting system and option gallery; Clubhouse maps to its tonal direction. Impeccable's Operate, craft-floor, clarify and polish guidance refines the implementation. The approved Clubhouse variant in `../repclub-mockups.html` is the concept reference; `app/globals.css` and the shipped components are the implementation source of truth.\n\nQuiet typography, open neutral space and lime actions support a private squad of college gym members in India. Home places three recent workout summaries and the weekly commitment together, with workout entry beside them on desktop. All activity opens on a separate screen. Squad standings are collapsed until requested, and workout controls come first on smaller screens. League, achievements and the staff desk retain their existing functions. The visual language stays compact and friendly through rows, separators and rounded controls, while attendance and reward status remain explicit.",
    "keyCharacteristics": [
      "Squad activity and weekly commitment lead the home surface.",
      "Lime identifies primary actions in both light and dark themes.",
      "Open, borderless sections contain tasks; rows and separators organise repeated content.",
      "Compact entry controls preserve a clear place to save details and finish a scan."
    ],
    "rules": [
      {
        "name": "The Lime Action Rule",
        "body": "Use the shared lime fill for primary actions and its theme-specific ink for the label. Use the darker accent-text token for links and focus in the light theme.",
        "section": "colors"
      },
      {
        "name": "The Status Has Words Rule",
        "body": "Pair attendance colour with a text status and an icon or step; colour alone does not explain verification or reward eligibility.",
        "section": "colors"
      },
      {
        "name": "The Interface Type Rule",
        "body": "Use the existing system stack for application headings and controls. Numeric data uses tabular figures; animation belongs to derived totals, never editable caret text.",
        "section": "typography"
      },
      {
        "name": "The Flat Task Rule",
        "body": "Keep task sections, summaries, notices and feed rows transparent and borderless. Reserve enclosing surfaces and shadows for functional popups and dialogs. Retain editable fields, action buttons, QR contrast and keyboard focus.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve brand lime and the complete light and dark theme mappings.",
      "Do use one primary action per task group and keep saving details distinct from scan checkout.",
      "Do organise activity and exercises with rows and separators and keep opened workout entry before the feed on narrow screens.",
      "Do use real data and a clear recovery action for empty, loading, error, pending, declined, manual and out-of-range states.",
      "Do keep phone fields at least 16px, retain useful coarse-pointer touch areas, and respect reduced-motion preferences."
    ],
    "donts": [
      "Don't reintroduce filled or outlined highlight boxes for task sections, summaries, notices, icon tiles or selected tabs.",
      "Don't introduce nested cards, metric-tile dashboards, decorative heading icons, eyebrows, progress rings or repeated reward explanations into the approved home and entry surfaces.",
      "Don't replace an exercise name or previous values while the person is typing; reusing previous values requires an explicit tap.",
      "Don't imply that manual history, missing checkout, out-of-range duration or pending review has already earned rewards.",
      "Don't describe source checks or the offline detector as browser approval, responsive measurement or phone-camera verification."
    ]
  }
}

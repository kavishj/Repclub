  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary-dark",
      "description": "The shared lime action; the active theme supplies its label ink.",
      "html": "<button class=\"ds-btn-primary\">Scan to start</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;border:1px solid transparent;border-radius:var(--control-radius,999px);font:600 13px/1.5 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;padding:10px 16px;white-space:nowrap;cursor:pointer;transition:background-color .16s,border-color .16s,box-shadow .16s,color .16s;background:var(--accent,#b9f25b);color:var(--accent-ink,#131519);border-color:var(--accent,#b9f25b)}.ds-btn-primary:hover:not(:disabled){background:color-mix(in srgb,var(--accent,#b9f25b) 88%,var(--panel,#20252d))}.ds-btn-primary:focus-visible{outline:2px solid var(--accent-text,#b9f25b);outline-offset:3px;}.ds-btn-primary:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn-primary{transition:none}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary-dark",
      "description": "A quieter companion action with a visible control boundary.",
      "html": "<button class=\"ds-btn-secondary\">Manual log</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;border:1px solid transparent;border-radius:var(--control-radius,999px);font:600 13px/1.5 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;padding:10px 16px;white-space:nowrap;cursor:pointer;transition:background-color .16s,border-color .16s,box-shadow .16s,color .16s;background:var(--panel,#20252d);color:var(--text,#e5e9ee);border-color:var(--control-line,#748295)}.ds-btn-secondary:hover:not(:disabled){background:var(--hover,#2a323e);border-color:var(--muted,#aab8ca)}.ds-btn-secondary:focus-visible{outline:2px solid var(--accent-text,#b9f25b);outline-offset:3px;}.ds-btn-secondary:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn-secondary{transition:none}}"
    },
    {
      "name": "Text Action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "An accent-text action for planning and small supporting tasks.",
      "html": "<button class=\"ds-btn-text\">Edit plan</button>",
      "css": ".ds-btn-text{display:inline-flex;align-items:center;gap:7px;min-height:36px;padding:0;border:0;background:transparent;color:var(--accent-text,#b9f25b);font:500 12px/1.5 system-ui,sans-serif;cursor:pointer;transition:color .16s}.ds-btn-text:hover{text-decoration:underline;text-underline-offset:4px}.ds-btn-text:focus-visible{outline:2px solid var(--accent-text,#b9f25b);outline-offset:3px;}.ds-btn-text:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn-text{transition:none}}"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "A circular, labelled utility action for a close or appearance control.",
      "html": "<button class=\"ds-btn-icon\" aria-label=\"Close workout editor\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m18 6-12 12M6 6l12 12\"/></svg></button>",
      "css": ".ds-btn-icon{display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;padding:10px;border:0;border-radius:50%;background:transparent;color:var(--muted,#aab8ca);cursor:pointer;transition:background-color .16s,color .16s}.ds-btn-icon:hover{background:var(--hover,#2a323e);color:var(--text,#e5e9ee)}.ds-btn-icon:focus-visible{outline:2px solid var(--accent-text,#b9f25b);outline-offset:3px;}.ds-btn-icon:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn-icon{transition:none}}"
    },
    {
      "name": "Exercise Search Field",
      "kind": "input",
      "refersTo": "input-dark",
      "description": "The free-text exercise input; the app attaches Base UI autocomplete.",
      "html": "<label class=\"ds-field-label\" for=\"ds-exercise\">Exercise</label><div class=\"ds-search\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input id=\"ds-exercise\" placeholder=\"Search or name an exercise\" autocomplete=\"off\"/></div>",
      "css": ".ds-field-label{display:block;font:400 12px/1.5 system-ui,sans-serif;color:var(--muted,#aab8ca)}.ds-search{display:flex;align-items:center;gap:8px;margin-top:8px;border:1px solid var(--control-line,#748295);background:var(--panel,#20252d);border-radius:var(--control-radius,999px);padding-left:12px;color:var(--muted,#aab8ca)}.ds-search:focus-within{outline:2px solid var(--accent-text,#b9f25b);outline-offset:2px}.ds-search input{width:100%;min-width:0;min-height:44px;padding:12px 12px 12px 0;border:0;border-radius:inherit;background:transparent;color:var(--text,#e5e9ee);font:400 16px/1.5 system-ui,sans-serif;outline:none;caret-color:var(--accent-text,#b9f25b)}.ds-search input::placeholder{color:var(--muted,#aab8ca);opacity:1}.ds-search input:disabled{opacity:.45}"
    },
    {
      "name": "Compact Select",
      "kind": "input",
      "refersTo": "select",
      "description": "Pill activity trigger; the application supplies the Base UI popup and selection behavior.",
      "html": "<button class=\"ds-select\" type=\"button\" aria-label=\"Workout activity\" aria-haspopup=\"listbox\"><span>Strength</span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></button>",
      "css": ".ds-select{display:flex;align-items:center;justify-content:space-between;gap:8px;width:200px;min-height:44px;padding:10px 14px;border:1px solid transparent;border-radius:var(--control-radius,999px);background:var(--panel-alt,#2f3742);color:var(--text,#e5e9ee);font:400 16px/1.5 system-ui,sans-serif;text-align:left;cursor:pointer;transition:background-color .16s,border-color .16s,color .16s}.ds-select:focus-visible,.ds-select[data-popup-open]{outline:2px solid var(--accent-text,#b9f25b);outline-offset:2px}.ds-select:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-select{transition:none}}"
    },
    {
      "name": "Numeric Entry",
      "kind": "input",
      "refersTo": "number-field",
      "description": "A centred tabular value with decrement and increment targets; Base UI owns number behavior in the app.",
      "html": "<label class=\"ds-number-label\" for=\"ds-sets\">Sets</label><div class=\"ds-number\"><button class=\"ds-step\" type=\"button\" aria-label=\"Decrease sets\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/></svg></button><input id=\"ds-sets\" inputmode=\"numeric\" value=\"3\" aria-label=\"Sets\"/><button class=\"ds-step\" type=\"button\" aria-label=\"Increase sets\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></button></div>",
      "css": ".ds-number-label{display:block;font:400 12px/1.5 system-ui,sans-serif;color:var(--muted,#aab8ca)}.ds-number{display:grid;grid-template-columns:28px minmax(0,1fr) 28px;align-items:center;width:200px;margin-top:8px;border-radius:16px;overflow:hidden;background:var(--panel-alt,#2f3742)}.ds-number:focus-within{outline:2px solid var(--accent-text,#b9f25b);outline-offset:2px}.ds-number input{width:100%;min-width:0;min-height:44px;padding:8px 0;border:0;background:transparent;color:var(--text,#e5e9ee);text-align:center;font:600 16px/1.5 system-ui,sans-serif;font-variant-numeric:tabular-nums;outline:none}.ds-step{display:grid;place-items:center;min-height:44px;min-width:24px;padding:0;border:0;background:transparent;color:var(--muted,#aab8ca);cursor:pointer;transition:background-color .16s,color .16s}.ds-step:hover{background:var(--hover,#2a323e);color:var(--text,#e5e9ee)}.ds-step:active{background:var(--accent-soft,#212a16)}.ds-step:focus-visible{outline:2px solid var(--accent-text,#b9f25b);outline-offset:3px;}.ds-step:disabled{opacity:.45;cursor:not-allowed}@media(pointer:coarse){.ds-number{grid-template-columns:repeat(2,minmax(0,1fr))}.ds-number input{grid-column:1/-1;grid-row:1}.ds-step{grid-row:2;min-width:44px}}@media(prefers-reduced-motion:reduce){.ds-step{transition:none}}"
    },
